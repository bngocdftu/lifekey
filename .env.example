# TideCloak master-admin (local Docker only). The init script and the LifeKey server use it.
# The server uses it ONLY to file change requests and read signed policies: in multiAdmin mode
# it cannot approve anything (approval needs a tide-realm-admin's enclave signature).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
TIDECLOAK_URL=http://localhost:8080

# Demo only: lets a tide-realm-admin file sample requests from /setup ("Create sample requests").
# They still wait for the real quorum; the log marks them as made by demo-seed. Leave off otherwise.
LIFEKEY_DEMO_SEED=0
